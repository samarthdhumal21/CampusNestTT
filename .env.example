# CampusNest Kolhapur Environment Configuration

# Google Maps JavaScript API Key
# Enable: Maps JavaScript API and Directions API in Google Cloud Console
# Restrict key by HTTP Referrer: http://localhost:5173/*
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Safe Quick Demo Logins (PART 6)
# Set to 'true' for local development & hackathon evaluation to test role-based portals in-memory.
# By default, keep 'false' in production so demo buttons remain hidden.
VITE_ENABLE_DEMO_LOGIN=false

# Firebase Configuration (Authentication & Cloud Firestore)
# Create a Web App in Firebase Console -> Project Settings -> General
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=campusnest-kolhapur.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=campusnest-kolhapur
VITE_FIREBASE_STORAGE_BUCKET=campusnest-kolhapur.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
